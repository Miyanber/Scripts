# ==============================================================================
# Environment Variables Template
# Copy this file to .env and configure the values according to your environment.
# ==============================================================================

# Chromium / Playwright Settings
# FONT_PATH=/path/to/custom/fonts

# Google API Credentials (if using custom credentials path)
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Export Google Forms settings
# EXPORT_FORMS_INPUT_HTML=class_archive.html
# EXPORT_FORMS_OUTPUT_DIR=exported_forms
